out/
*.pyc
.env

# Local cache of each plant's quality Google Sheet (regenerated by --refresh-sheets;
# it's the *whole* multi-year workbook, 1-3MB per plant — not worth committing).
# The report data actually used is exported as a small JSON snapshot alongside it
# (data/snapshots/*/quality/*.json), which IS committed — that keeps QC and
# production-staff names for reference without carrying the raw workbooks in
# git history. truck_registry.xlsx (~32KB, one tab per month) stays committed.
data/snapshots/*/quality/*.xlsx
